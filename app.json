{
  "expo": {
    "name": "보험맵",
    "slug": "insurance-community-mobile",
    "owner": "ohyoonseok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "boheommap",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bohummap.app",
      "associatedDomains": [
        "applinks:bohummap.com"
      ]
    },
    "android": {
      "package": "com.bohummap.app",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bohummap.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2472EC",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#4A93F5"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "보험맵이 내 주변 GA 지점을 지도에 표시하기 위해 위치 정보를 사용합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "다운로드한 이미지를 갤러리에 저장하기 위해 접근합니다.",
          "savePhotosPermission": "다운로드한 이미지를 갤러리에 저장하기 위해 접근합니다."
        }
      ],
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "보험맵 앱 잠금을 해제하기 위해 Face ID를 사용합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "명함/프로필 QR 코드를 스캔하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#152D70"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c1ea2bd3-f94f-4b3d-94ce-88de77907ee4"
      }
    }
  }
}
